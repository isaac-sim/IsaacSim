[package]
title = "Isaac Sim Python"
description = "A trimmed down app for use with python providing zero frame delay"
version = "6.2.0"
execFile = "isaac-sim.zero_delay"
keywords = ["experience", "app", "usd", "isaacsim"] # That makes it browsable in UI with "experience" filter


[dependencies]
"isaacsim.exp.base" = {}

[settings]
rtx.spg.enabled = true # Enable RTX Sensor Processing Graphs feature
exts."isaacsim.ros2.bridge".publish_multithreading_disabled = true # disable multithreading for ros2 bridge to reduce latency
exts."isaacsim.ros2.bridge".publish_with_queue_thread = false # disable queue-based thread mode for ros2 bridge

[settings.app]
name = "Isaac-Sim Zero Delay"
version = "6.2.0"
hydraEngine.waitIdle = true
updateOrder.checkForHydraRenderComplete = 1000
vulkan = true                     # Explicitly enable Vulkan
enableDeveloperWarnings = false   # disable developer warnings to reduce log noise

[settings.app.exts.folders]
'++' = [
    "${app}",
    "${app}/../exts",
    "${app}/../extscache",
    "${app}/../extsUser",
    "${app}/../extsDeprecated",
]
