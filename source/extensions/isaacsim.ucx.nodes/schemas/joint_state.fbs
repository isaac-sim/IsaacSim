include "tensor.fbs";
include "header.fbs";

namespace isaac;

// Describes the state of a set of torque-controlled joints.
table JointState {

  // Header
  header: holoscan.schema.Header (id: 0);

  // Names of the joints.
  name: [string] (id: 1);

  // Position of each joint (radians or meters).
  position: holoscan.schema.Tensor (id: 2);

  // Velocity of each joint (radians/second or meters/second).
  velocity: holoscan.schema.Tensor (id: 3);

  // Acceleration of each joint (radians/second^2 or meters/second^2).
  acceleration: holoscan.schema.Tensor (id: 4);

  // Actuator effort applied in each joint (Newton meters or Newtons).
  effort: holoscan.schema.Tensor (id: 5);

  // Temperature of each joint (Celsius).
  temperature: holoscan.schema.Tensor (id: 6);
}

root_type JointState;

file_identifier "IJST";
