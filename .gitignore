# ==============================================================================
# NV-BASE skill validation artifacts. Keep the repo clean of transient run
# output while still committing the per-skill evals/evals.json datasets.
# ==============================================================================
# Per-skill Tier 3 agent-eval scratch/results. The results tree copies the whole
# skills/ catalog into per-task environments and pollutes similarity/dedup scans.
skills/**/evals/results/
skills/**/evals/results/**

# Catalog-level aggregated eval datasets. Regenerated on every local run by
# tools/ci/gitlab/skills/aggregate_skill_evals.py from the per-skill evals.json files;
# not consumed by CI, so treat as derived artifacts (do not commit).
/skills/evals/
/skills/_internal/evals/

# Library wheel build artifacts (never commit; use CMake/wheel build output)
source/libraries/dist/
